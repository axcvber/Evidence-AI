# apps/api – copy to apps/api/.env (or run `pnpm env:init`). Local development values only.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Swagger UI at /docs. Defaults to on outside production and off in production.
# API_DOCS_ENABLED=true

# Connects as evidence_app (no superuser, no BYPASSRLS) so RLS always applies.
DATABASE_URL=postgresql://evidence_app:evidence-app-local-dev@localhost:5440/evidence
REDIS_URL=redis://:redis-local-dev@localhost:6390/0

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=evidence-documents
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-local-dev
S3_FORCE_PATH_STYLE=true

LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev

# ---------- integration tests (pnpm test) ----------
TEST_DATABASE_URL=postgresql://evidence_app:evidence-app-local-dev@localhost:5440/evidence_test
TEST_DATABASE_OWNER_URL=postgresql://evidence_owner:evidence-owner-local-dev@localhost:5440/evidence_test
