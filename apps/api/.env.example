# apps/api – copy to apps/api/.env (or run `pnpm env:init`). Local development values only.
NODE_ENV=development
PORT=4000
# Swagger UI at /api/docs (and Better Auth's reference at /api/auth/reference). Defaults to on
# outside production and off in production.
# API_DOCS_ENABLED=true
# Canned /api/dev-mocks/* endpoints with real role checks; on outside production, never in production.
# DEV_MOCKS_ENABLED=true

# Connects as evidence_app (no superuser, no BYPASSRLS) so RLS always applies.
DATABASE_URL=postgresql://evidence_app:evidence-app-local-dev@localhost:5440/evidence
# Sessions and auth rate limits live here (shared by every API instance).
REDIS_URL=redis://:redis-local-dev@localhost:6390/0

# ---------- auth (Better Auth) ----------
# Connects as evidence_auth: auth tables only, never tenant data.
AUTH_DATABASE_URL=postgresql://evidence_auth:evidence-auth-local-dev@localhost:5440/evidence
# Generate a real one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=local-dev-secret-change-me-at-least-32-chars
# Public origin of the app. The browser reaches the API through the web app's /api proxy.
BETTER_AUTH_URL=http://localhost:3000

# Client IP for rate limits. Locally the Next proxy forwards x-forwarded-for unchanged, so it
# can be spoofed in dev; production sets the load balancer's header and its proxy addresses.
# CLIENT_IP_HEADER=x-forwarded-for
# TRUSTED_PROXIES=10.0.0.0/24

# ---------- email (Resend) ----------
# Without a key (local dev only), emails are written to the API log instead of being sent.
# RESEND_API_KEY=re_...
# Must be on a domain verified in Resend (dev.axlisovsky.com is verified for this project).
EMAIL_FROM=Evidence AI <evidence@dev.axlisovsky.com>

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=evidence-documents
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-local-dev
S3_FORCE_PATH_STYLE=true

LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev

# ---------- integration tests (pnpm test) ----------
TEST_DATABASE_URL=postgresql://evidence_app:evidence-app-local-dev@localhost:5440/evidence_test
TEST_AUTH_DATABASE_URL=postgresql://evidence_auth:evidence-auth-local-dev@localhost:5440/evidence_test
TEST_DATABASE_OWNER_URL=postgresql://evidence_owner:evidence-owner-local-dev@localhost:5440/evidence_test
TEST_REDIS_URL=redis://:redis-local-dev@localhost:6390/1
