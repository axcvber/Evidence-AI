# packages/db – copy to packages/db/.env (or run `pnpm env:init`). Local development values only.
# Owner role: migrations only. Never give this URL to the api or worker.
DATABASE_OWNER_URL=postgresql://evidence_owner:evidence-owner-local-dev@localhost:5440/evidence

# ---------- integration tests (pnpm test) ----------
TEST_DATABASE_URL=postgresql://evidence_app:evidence-app-local-dev@localhost:5440/evidence_test
TEST_DATABASE_OWNER_URL=postgresql://evidence_owner:evidence-owner-local-dev@localhost:5440/evidence_test
